storage/tmp/

# Dependencies
node_modules/
vendor/

# Environment
.env
.env.*
!.env.example

# Legacy Node/Next.js build output (reference only)
.next/
out/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
jest-test-results.json

# IDEs
.vscode/
.idea/
